<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="red_ball">

    <!-- 动态刚体 -->
    <static>false</static>

    <link name="ball_link">

      <!-- ================= 质量与惯性 ================= -->

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <!-- 实心球转动惯量：I = 2/5 * m * r^2 -->
          <ixx>0.000064</ixx>
          <iyy>0.000064</iyy>
          <izz>0.000064</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- ================= 碰撞模型 ================= -->

      <collision name="ball_collision">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ================= 视觉模型 ================= -->

      <visual name="ball_visual">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <shininess>50</shininess>
        </material>
      </visual>

    </link>
  </model>
</sdf>