# ==========================================
# ROS 项目标准 .gitignore 模板
# ==========================================

# 1. ROS 编译与运行产生的目录 (核心！千万不要传)
build/
devel/
install/
logs/
log/
.built_with_make/

# 2. C/C++ 编译产生的中间文件
*.o
*.so
*.a
*.obj
*.d
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# 3. Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 4. 编辑器与 IDE 配置文件
# 这样不会把你个人的编辑器设置传给同事
.vscode/
.idea/
*.swp
*.swo
*~

# 5. 系统生成的文件
.DS_Store
Thumbs.db

# 6. 环境变量与日志文件
.env
*.log
*.bag